# AI 识别服务商配置（可选）
#
# 推荐做法：直接在网页右上角点「AI 设置」填写，Key 只存在浏览器本地存储里。
# 这个文件用于「预置一个默认 Key 给所有用户」的场景（比如部署给别人用）。
#
# 复制这个文件为 .env.local，填好 Key 后重启 dev server（改 .env 必须重启才生效）。
#
# 支持的 provider：gemini / openai / custom

# ---------- Google Gemini ----------
# 获取 Key：https://aistudio.google.com/apikey
# VITE_AI_PROVIDER=gemini
# VITE_GEMINI_API_KEY=your_gemini_key
# VITE_AI_MODEL=gemini-2.5-flash

# ---------- OpenAI ----------
# 获取 Key：https://platform.openai.com/api-keys
# VITE_AI_PROVIDER=openai
# VITE_OPENAI_API_KEY=your_openai_key
# VITE_AI_MODEL=gpt-4o-mini

# ---------- 自定义（任何 OpenAI 兼容端点）----------
# VITE_AI_PROVIDER=custom
# VITE_AI_BASE_URL=https://your-endpoint/v1
# VITE_AI_MODEL=your-model-id
# VITE_AI_API_KEY=your_key
# 是否发送 response_format 参数。部分 Coding Plan 端点不支持，设为 false 关闭
# VITE_AI_JSON_MODE=true

# ---------- 国内 Coding Plan 端点参考 ----------
# 智谱 GLM Coding Plan
#   VITE_AI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
#   VITE_AI_MODEL=glm-5.3
# 阿里云百炼 Coding Plan（Key 以 sk-sp- 开头）
#   VITE_AI_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
#   VITE_AI_MODEL=qwen3.7-plus
# Kimi / 月之暗面
#   VITE_AI_BASE_URL=https://api.moonshot.cn/v1
#   VITE_AI_MODEL=kimi-k3.1-pro
